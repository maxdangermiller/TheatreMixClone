{
  "name": "PresonusTheatreMix",
  "productName": "Presonus TheatreMix",
  "version": "1.2.0",
  "description": "An Electron app to allow TheatreMix to work on Presonus StudioLive consoles",
  "main": ".vite/build/main.cjs",
  "private": true, 
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "postinstall": "patch-package; npm run rebuild",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "TheatreMix",
    "Presonus",
    "StudioLive"
  ],
  "author": {
    "name": "Max Miller",
    "email": "max@benmiller.com"
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "^44.4.5",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "vite": "^8.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@featherbear/presonus-studiolive-api": "^1.8.0",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "process": "^0.11.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "allowScripts": {
    "dtrace-provider": true,
    "electron-winstaller": true,
    "fs-xattr": true,
    "macos-alias": true,
    "postinstall-postinstall": true,
    "better-sqlite3": true,
    "fsevents": true
  }
}
